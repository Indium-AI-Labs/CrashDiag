# Sandbox deployment. Generate a strong token, for example with:
# openssl rand -hex 32
CRASHDIAG_SANDBOX_TOKEN=

# Optional sandbox bounds (defaults shown).
CRASHDIAG_MAX_SESSIONS=128
CRASHDIAG_SESSION_TTL_SECONDS=900
CRASHDIAG_MAX_OPERATIONS_PER_SESSION=64
CRASHDIAG_MAX_WORKERS=64
CRASHDIAG_REQUEST_TIMEOUT_SECONDS=10

# Dataset/training machine only. Never copy HF_TOKEN to the sandbox host.
HF_TOKEN=
CRASHDIAG_HF_BUCKET_ID=your-namespace/CrashDiag
CRASHDIAG_ARTIFACT_PREFIX=runs
CRASHDIAG_ARTIFACT_LOCAL_ROOT=artifacts
CRASHDIAG_ARTIFACT_UPLOAD_POLICY=required
# Set true only when creating a new private artifact bucket.
CRASHDIAG_CREATE_ARTIFACT_BUCKET=false

# Remote sandbox used for mechanical reward and evaluation.
CRASHDIAG_SANDBOX_URL=https://sandbox.example.com
CRASHDIAG_API_TOKEN=

# Artifact handoffs. Dataset generation creates the first value; the training
# and evaluation runners create the others when they are left blank.
CRASHDIAG_DATASET_RUN_ID=
CRASHDIAG_BASE_EVAL_RUN_ID=
CRASHDIAG_GRPO_RUN_ID=
CRASHDIAG_GRPO_EVAL_RUN_ID=

# Optional notebook controls.
# CRASHDIAG_ENV_FILE=/absolute/path/to/env.txt
# CRASHDIAG_WORKDIR=/absolute/path/to/CrashDiag-runtime
# CRASHDIAG_SOURCE_COMMIT=main
# CRASHDIAG_REPO_URL=https://github.com/Indium-AI-Labs/CrashDiag.git
# CRASHDIAG_BASE_EVAL_MAX_NEW_TOKENS=96
