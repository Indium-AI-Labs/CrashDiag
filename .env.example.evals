# Required for every eval notebook (see notebooks/eval_all_baselines.ipynb and notebooks/<slug>/eval_*.ipynb)
HF_TOKEN=
CRASHDIAG_DATASET_RUN_ID=
CRASHDIAG_SANDBOX_URL=https://sandbox.devaanshpathak.com
CRASHDIAG_SANDBOX_TOKEN=

# Must match the deployed sandbox's CRASHDIAG_SANDBOX_TOKEN for http.py Bearer auth.
# CRASHDIAG_API_TOKEN is an alias for CRASHDIAG_SANDBOX_TOKEN in the notebooks — either
# one works, but at least one must be set to the same value the Vultr host uses.
# CRASHDIAG_API_TOKEN=

# Optional: pin the repo revision the notebooks check out (default: main).
# Use the commit pushed before your benchmark so notebooks and bucket data match.
# CRASHDIAG_SOURCE_COMMIT=5e7c69d

# Optional: override the hard-v3 curriculum selection (default: hard-v3 for all evals).
# Set to anything other than hard-v3 to fall back to grpo_eval.jsonl.
# CRASHDIAG_CURRICULUM=hard-v3

# Optional overrides for hosted notebook runtimes.
# CRASHDIAG_REPO_URL=https://github.com/Indium-AI-Labs/CrashDiag.git
# CRASHDIAG_ENV_FILE=/absolute/path/to/.env
# CRASHDIAG_WORKDIR=/absolute/path/to/CrashDiag-runtime

# Private HF storage bucket (default: devaanshpa/CrashDiag — same as notebooks).
# CRASHDIAG_HF_BUCKET_ID=devaanshpa/CrashDiag

# Per-model base-eval run IDs (optional — notebooks auto-generate IST run IDs if omitted).
# Set these only when resuming or fixing a specific base-eval stage.
# CRASHDIAG_BASE_QWEN2.5_14B_RUN_ID=
# CRASHDIAG_BASE_QWEN2.5_7B_RUN_ID=
# CRASHDIAG_BASE_QWEN2.5_3B_RUN_ID=
# CRASHDIAG_BASE_QWEN2.5_1.5B_RUN_ID=
# CRASHDIAG_BASE_QWEN2.5_0.5B_RUN_ID=

# Per-model SFT / GRPO run IDs (required only when running the per-model train/eval
# notebooks or the eval_all_*.ipynb sweeps). Each notebook also auto-generates an
# SFT/GRPO eval run ID if omitted.
# CRASHDIAG_SFT_RUN_ID=
# CRASHDIAG_SFT_EVAL_RUN_ID=
# CRASHDIAG_GRPO_RUN_ID=
# CRASHDIAG_GRPO_EVAL_RUN_ID=

# Optional per-model eval run IDs for notebooks/eval_all_sft.ipynb and
# notebooks/eval_all_grpo.ipynb — auto-generated IST run IDs are used when omitted.
# CRASHDIAG_SFT_EVAL_QWEN2.5_14B_RUN_ID=
# CRASHDIAG_GRPO_EVAL_QWEN2.5_14B_RUN_ID=
