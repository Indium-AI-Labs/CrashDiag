# Required for every eval notebook (notebooks/qwen2.5_3b/eval_*.ipynb)
HF_TOKEN=
CRASHDIAG_DATASET_RUN_ID=
CRASHDIAG_SANDBOX_URL=https://sandbox.devaanshpathak.com
CRASHDIAG_SANDBOX_TOKEN=

# Must match the deployed sandbox's CRASHDIAG_SANDBOX_TOKEN for http.py Bearer auth.
# CRASHDIAG_API_TOKEN is an alias for CRASHDIAG_SANDBOX_TOKEN in the notebooks — either
# one works, but at least one must be set to the same value the Vultr host uses.
# CRASHDIAG_API_TOKEN=

# Optional: pin the repo revision the notebooks check out (default: main).
# Use the commit pushed before your benchmark so notebooks and bucket data match.
# CRASHDIAG_SOURCE_COMMIT=5e7c69d

# Optional: override the curriculum selection (default: v5 for all evals).
# CRASHDIAG_CURRICULUM=v5

# Optional overrides for hosted notebook runtimes.
# CRASHDIAG_REPO_URL=https://github.com/Indium-AI-Labs/CrashDiag.git
# CRASHDIAG_ENV_FILE=/absolute/path/to/.env
# CRASHDIAG_WORKDIR=/absolute/path/to/CrashDiag-runtime

# Private HF storage bucket (default: devaanshpa/CrashDiag — same as notebooks).
# CRASHDIAG_HF_BUCKET_ID=devaanshpa/CrashDiag

# Single model base-eval run ID (optional — the notebook auto-generates an IST run ID if omitted).
# CRASHDIAG_BASE_QWEN2.5_3B_RUN_ID=

# SFT / GRPO run IDs (required only when running the per-model train/eval notebooks).
# CRASHDIAG_SFT_RUN_ID=
# CRASHDIAG_SFT_EVAL_RUN_ID=
# CRASHDIAG_GRPO_RUN_ID=
# CRASHDIAG_GRPO_EVAL_RUN_ID=
