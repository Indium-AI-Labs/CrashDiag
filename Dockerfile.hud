FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY LICENSE ./
COPY crashdiag/ ./crashdiag/
COPY training/ ./training/
COPY env.py ./

RUN python -m pip install --no-cache-dir "hud==0.6.15"

USER 65532:65532
EXPOSE 8765

CMD ["hud", "serve", "env:env", "--host", "0.0.0.0", "--port", "8765"]
