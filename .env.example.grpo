# Required for notebooks/grpo_all.ipynb (Qwen2.5 GRPO + eval, all models, one run ID).

# Fine-grained write token for the private HF storage bucket.
HF_TOKEN=

# Run ID of the fresh dataset-generation stage (see scripts/fresh_start.py).
CRASHDIAG_DATASET_RUN_ID=

# Single SFT-all run ID produced by notebooks/sft_all.ipynb. All models' SFT
# adapters are downloaded from this one run.
CRASHDIAG_SFT_RUN_ID=

# Sandbox service used for mechanical reward / evaluation scoring.
CRASHDIAG_SANDBOX_URL=https://sandbox.devaanshpathak.com
# Must match the deployed sandbox's CRASHDIAG_SANDBOX_TOKEN for Bearer auth.
# CRASHDIAG_API_TOKEN is an alias — either one works, at least one must be set.
CRASHDIAG_SANDBOX_TOKEN=

# Optional: curriculum selection (default: hard-v4). hard-v3 and hard-v4 both use
# grpo_hard_train.jsonl / grpo_hard_eval.jsonl; anything else uses grpo_train/eval.
# CRASHDIAG_CURRICULUM=hard-v4

# Optional: pin the repo revision the notebook checks out (default: main).
# Use the commit pushed before your run so notebooks and bucket data match.
# CRASHDIAG_SOURCE_COMMIT=5e7c69d

# Optional overrides for hosted notebook runtimes.
# CRASHDIAG_REPO_URL=https://github.com/Indium-AI-Labs/CrashDiag.git
# CRASHDIAG_ENV_FILE=/absolute/path/to/.env
# CRASHDIAG_WORKDIR=/absolute/path/to/CrashDiag-runtime

# Private HF storage bucket (default: devaanshpa/CrashDiag — same as the notebook).
# CRASHDIAG_HF_BUCKET_ID=devaanshpa/CrashDiag

# Optional: pin the single run ID all models upload under (default: auto-generated
# IST timestamp + "-all"). Set only when resuming or fixing a specific run.
# CRASHDIAG_ALL_RUN_ID=
