# Required by scripts/grpo.sh and notebooks/qwen2.5_3b/grpo.ipynb.

# Fine-grained write token for the private Hugging Face artifact bucket.
HF_TOKEN=

# Private bucket used for dataset and checkpoint handoffs.
CRASHDIAG_HF_BUCKET_ID=your-namespace/CrashDiag

# Run ID of the mechanically validated dataset stage.
CRASHDIAG_DATASET_RUN_ID=

# Sandbox service used for training reward and replay evaluation.
CRASHDIAG_SANDBOX_URL=https://sandbox.example.com
# Must match the deployed sandbox bearer token. CRASHDIAG_API_TOKEN is an alias.
CRASHDIAG_SANDBOX_TOKEN=

# Optional: curriculum selection (default: v5).
# CRASHDIAG_CURRICULUM=v5

# Optional: pin the source revision and hosted-notebook checkout.
# CRASHDIAG_SOURCE_COMMIT=main
# CRASHDIAG_REPO_URL=https://github.com/Indium-AI-Labs/CrashDiag.git
# CRASHDIAG_ENV_FILE=/absolute/path/to/env.txt
# CRASHDIAG_WORKDIR=/absolute/path/to/CrashDiag-runtime

# 14B Docker run (scripts/run_14b.sh). Leave unset for the 3B mock path.
# CRASHDIAG_BASE_MODEL=Qwen/Qwen2.5-14B-Instruct
# CRASHDIAG_MODEL_SLUG=qwen2.5_14b
# CRASHDIAG_REQUIRE_SANDBOX_BACKEND=docker
# CRASHDIAG_GRPO_LOAD_IN_4BIT=1
# CRASHDIAG_GRPO_BATCH_SIZE=1
# CRASHDIAG_GRPO_GRAD_ACCUM=8
# CRASHDIAG_GRPO_PRECISION=bf16

# Optional stable run IDs.
# CRASHDIAG_GRPO_RUN_ID=
# CRASHDIAG_GRPO_EVAL_RUN_ID=

# Optional final-run overrides.
# CRASHDIAG_GRPO_NUM_GENERATIONS=4
# CRASHDIAG_GRPO_LEARNING_RATE=5e-6
# CRASHDIAG_GRPO_LR_SCHEDULER=constant_with_warmup
# CRASHDIAG_GRPO_WARMUP_RATIO=0.05
# CRASHDIAG_GRPO_TEMPERATURE=1.0
# CRASHDIAG_GRPO_TOP_P=0.95
# CRASHDIAG_GRPO_MAX_COMPLETION_LENGTH=96
# CRASHDIAG_GRPO_EVAL_MAX_NEW_TOKENS=96
# CRASHDIAG_GRPO_MAX_STEPS=832
# CRASHDIAG_GRPO_DATALOADER_WORKERS=4
# CRASHDIAG_GRPO_DATALOADER_PREFETCH=4
